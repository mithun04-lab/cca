​​​H_Cycle(2);
​​​if (found == false)
​​​​System.out.println("No Solution possible!");
​}
​
​static void H_Cycle(int k)
​{
​​while (true)
​​{
​​​NextValue(k, G, x, n);
​​​if (x[k] == 0)
​​​​​return;
​​​if (k == n)
​​​{
​​​​for (int i = 1; i <= k; i++)
​​​​​​System.out.print(x[i] + "--> ");
​​​​System.out.println(x[1]);
​​​​System.out.println();
​​​​found = true;
​​​}
​​​else
​​​​H_Cycle(k + 1);
​​}
​}
​static void NextValue(int k, int G[][], int x[], int n)
​{
​​while (true)
​​{
​​​x[k] = (x[k] + 1) % (n + 1);
​​​if (x[k] == 0)
​​​​return;
​​​if (G[x[k - 1]][x[k]] != 0)
​​​{
​​​​int j;
​​​​for (j = 1; j < k; j++)
​​​​{
​​​​​if (x[k] == x[j])
​​​​​​break;
​​​​}
​​​​if (j == k)
​​​​{
​​​​​if ((k < n) || ((k == n) && G[x[n]][x[1]] != 0))
​​​​​​return;
​​​​}
​​​}
​​}
​}
}
 
