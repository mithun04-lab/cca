​​​for (int i = 1; i <= n; i++)
​​​{
​​​​for (int j = 1; j <= n; j++)
​​​​{
​​​​​G[i][j] = scanner.nextInt();
​​​​​x[i] = 0;
​​​​}
​​​}
​​​x[1] = 1;
